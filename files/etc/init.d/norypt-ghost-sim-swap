#!/bin/sh /etc/rc.common
# Norypt Ghost — sim-swap Stage 2 completion
#
# Runs at START=25, after gl_cellular_manager (S23) has initialized the modem
# subsystem and the AT socket is responsive.
#
# Note: S18 and S22 were tested and failed — the Quectel MHI modem stack on
# the RG650V-NA requires gl_cellular_manager to fully initialize before the
# AT socket accepts commands. S25 is the earliest reliable priority.
#
# Because S25 is the earliest point the AT socket answers, gl_cellular_manager
# (S23) can attach the Stage 1 THROWAWAY IMEI for a few seconds before this
# runs. That is the design's accepted cost: the throwaway is random, written
# while RF was off, and never linked to the old identity — so neither real
# identity bridges the swap. This service polls every second, cuts RF the
# moment AT answers, writes + verifies the final IMEIs, then re-enables RF.
# The pending file is removed only after a verified write, so a failed write
# retries on the next boot with RF still off.
#
# On normal boots (no pending sim-swap) this script exits immediately with
# zero overhead.

. /lib/norypt-ghost/functions.sh

# shellcheck disable=SC2034
START=25
# shellcheck disable=SC2034
STOP=99

# Poll until the modem AT interface is truly ready, or 30s timeout.
# Checks both that the socket file exists AND that ATI returns OK — gl_modem
# exits 0 even when the socket isn't yet accepting connections, so a simple
# exit-code check is insufficient. Polls every second: every second saved
# here is a second less of the throwaway IMEI on air during a sim-swap.
_wait_for_at() {
    local elapsed=0
    while [ "$elapsed" -lt 30 ]; do
        if [ -S /tmp/modem.CPU.AT.sock ]; then
            local resp
            resp=$(gl_modem -B "$BUS" -U 1 AT ATI 2>/dev/null)
            if echo "$resp" | grep -q "OK"; then
                return 0
            fi
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
    logger -p err -t norypt-ghost "sim-swap: AT interface not ready after 30s"
    return 1
}

start() {
    # Full-identity rotation (new-identity): IMEIs were already written before
    # the reboot; verify them (and rewrite if needed) before showing anything.
    if [ -f /etc/norypt-ghost.identity-pending ]; then
        # shellcheck source=/dev/null
        . /lib/norypt-ghost/identity.sh
        _wait_for_at || { _screen_splash error; return 1; }
        IDENTITY_APPLY_BOOT
        return 0
    fi

    [ -f /etc/norypt-ghost.sim-swap-pending ] || return 0

    # On timeout the pending file is intentionally left in place so Stage 2
    # retries on the next boot; the modem keeps the safe throwaway IMEI.
    _wait_for_at || { _screen_splash error; return 1; }

    # Registration snapshot first (two quick reads), then RF off immediately:
    # gl_cellular_manager (S23) may already have attached the throwaway IMEI.
    # Only the registration state is logged — never an IMEI or IMSI.
    local _cereg1 _cereg2
    _cereg1=$(gl_modem -B "$BUS" -U 1 AT 'AT+CEREG?' 2>/dev/null | tr -d '\r' | grep -o '+CEREG:.*')
    _cereg2=$(gl_modem -B "$BUS" -U 2 AT 'AT+CEREG?' 2>/dev/null | tr -d '\r' | grep -o '+CEREG:.*')
    MODEM_RF_DISABLE
    logger -p notice -t norypt-ghost "sim-swap throwaway window: slot1 ${_cereg1:-none} slot2 ${_cereg2:-none}"

    _screen_splash rotating
    _screen_msg "SIM swap: completing final IMEI write..."

    local SLOT1_MODE="" SLOT2_MODE=""
    . /etc/norypt-ghost.sim-swap-pending

    local imei1 imei2
    imei1=$(_gen_imei 1 "$SLOT1_MODE")
    imei2=$(_gen_imei 2 "$SLOT2_MODE")

    if ! IMEI_VALID "$imei1" || ! IMEI_VALID "$imei2"; then
        logger -p err -t norypt-ghost "sim-swap: IMEI generation failed — RF left disabled, retrying next boot"
        _screen_splash error
        return 1
    fi

    if ! SET_IMEIS "$imei1" "$imei2" || ! VERIFY_IMEIS "$imei1" "$imei2"; then
        logger -p err -t norypt-ghost "sim-swap: IMEI write/verify failed — RF left disabled, retrying next boot"
        _screen_splash error
        return 1
    fi

    # Done: Stage 2 must not repeat once the final IMEIs are verified.
    rm -f /etc/norypt-ghost.sim-swap-pending
    date '+%Y-%m-%d %H:%M (sim-swap)' > /tmp/norypt-ghost.last_imei_rotate

    RAT_LOCK_APPLY
    # Bring RF back on so gl_cellular_manager finds the modem in a normal
    # state and handles registration with the final IMEI.
    _at AT+CFUN=1 >/dev/null 2>&1
    sleep 2

    logger -p notice -t norypt-ghost "sim-swap complete"
    _screen_msg "SIM swap: done. Registering with new identity..."
    _screen_splash "done"
}

stop() { return 0; }
